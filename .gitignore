node_modules/
dist/
build/
.vite/
*.tsbuildinfo
playwright-report/
test-results/
.eslintcache

# ---------------------------------------------------------------------------
# Secrets — constitution v1.2.0, Principle IV.
# Secrets are supplied at runtime, never committed. Only deploy/.env.example
# (non-secret placeholders) belongs in the repository.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
deploy/.env
deploy/.env.*
!deploy/.env.example

# The media host's placeholders (T185). Needs its own negation: `deploy/.env.*`
# matches it, and `!deploy/.env.example` un-ignores only that exact name — so
# without this line the example nobody can deploy without is silently untracked.
!deploy/.env.media.example
*.pem
*.key
*.crt
*.pfx
deploy/certs/*
!deploy/certs/.gitkeep
deploy/secrets/

# ---------------------------------------------------------------------------
# Local runtime state — Compose volumes must never be committed
# ---------------------------------------------------------------------------
deploy/data/
*.log

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.tmp
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json

# Snapshot of the load-test database volume (tens of GB). See tests/Load/README.md.
.loadvolume/
