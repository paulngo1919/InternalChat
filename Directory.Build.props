<Project>

  <!--
    Constitution v1.2.0, Principle II (SOLID by Default):
    static analysis MUST be enabled and MUST NOT be suppressed without an inline
    justification naming the rule and the reason.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Deterministic, reproducible builds (constitution: builds reproducible from the repo alone) -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Test projects: coverage collection per Principle III -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>

    <!--
      Analyzer suppressions for test projects only. Constitution Principle II requires an
      inline justification naming the rule and the reason, which is what this comment is.

      CA1707 (no underscores in member names)
        Test names use Subject_does_thing_when_condition, the standard xUnit convention. It is
        what makes a failing test readable in CI output, where the method name is often the
        only thing shown. Production code is unaffected — this applies only to *Tests projects.

      CA1861 (avoid constant arrays as arguments)
        [InlineData] attributes and inline expectation arrays trigger this by design. The
        suggested fix — hoisting every literal to a static field — makes test data harder to
        read at the point of use, which is the opposite of what a test should optimise for.

      CA1001 (type owns disposable fields but is not disposable)
        xUnit owns test-class lifetime through IAsyncLifetime, whose DisposeAsync the analyzer
        does not recognise as disposal. Implementing IAsyncDisposable as well would collide with
        it — both declare DisposeAsync, differing only in return type. Resources held by test
        classes ARE released, in the IAsyncLifetime.DisposeAsync override.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1001</NoWarn>
  </PropertyGroup>

</Project>
