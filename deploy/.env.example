# =============================================================================
# InternalChat — local development environment
#
# Onboarding is three steps (constitution v1.2.0, Local Environment):
#   git clone <repo> && cd InternalChat
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d
#
# THIS FILE CONTAINS NON-SECRET PLACEHOLDERS ONLY and is committed.
# `deploy/.env` is git-ignored and is where real values live. Never invert that.
#
# The values below are deliberately weak and obviously fake. They are safe for a
# laptop and unsafe for anything else. Production values are supplied by the
# platform secret store at runtime, never by a file in this repository
# (Principle IV: "Secrets ... MUST NOT appear in source").
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Namespaces every Redis key as internalchat:{env}:{entity}:{id} (Principle VII).
INTERNALCHAT_ENV=dev
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# Published ports (host side). See specs/.../quickstart.md for the URL table.
# -----------------------------------------------------------------------------
WEB_PORT=8080
API_PORT=8081
KEYCLOAK_PORT=8082
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# PostgreSQL — the single source of truth (Principle VII)
# -----------------------------------------------------------------------------
POSTGRES_DB=internalchat
POSTGRES_USER=internalchat
POSTGRES_PASSWORD=change-me-postgres

# The application role. Distinct from the owner above because the migration
# runner needs DDL rights and the application must not have them — and because
# T048 grants this role INSERT-only on audit_event (Principle IV: audit records
# MUST NOT be modifiable or deletable by application code).
POSTGRES_APP_USER=internalchat_app
POSTGRES_APP_PASSWORD=change-me-postgres-app

# -----------------------------------------------------------------------------
# Redis — cache, SignalR backplane, presence, token revocation set
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# -----------------------------------------------------------------------------
# RabbitMQ — every side effect goes through here (Principle VI)
# -----------------------------------------------------------------------------
RABBITMQ_USER=internalchat
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=internalchat

# -----------------------------------------------------------------------------
# Keycloak — OIDC provider. No passwords are ever stored by this application.
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_REALM=internalchat
KEYCLOAK_CLIENT_ID=internalchat-web
# Confidential client secret used by the API for back-channel logout validation.
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client

# -----------------------------------------------------------------------------
# MinIO — S3-compatible object storage for attachments
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=internalchat
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
MINIO_BUCKET=attachments
# Uploads land here and become retrievable only after ClamAV records a clean
# verdict (FR-024, research.md D7).
MINIO_QUARANTINE_BUCKET=quarantine

# -----------------------------------------------------------------------------
# Web push (VAPID). Generate a real pair with:
#   npx web-push generate-vapid-keys
# Placeholders below are not valid keys — push is simply inert until you set them.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_SUBJECT=mailto:dev@example.invalid

# -----------------------------------------------------------------------------
# LiveKit — media host only (deploy/docker-compose.media.yml, US8/US9).
# The application MUST stay fully functional with these unset and the media host
# absent; meetings degrade to "unavailable", messaging does not (constitution:
# Deployment Strategy).
# -----------------------------------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret-at-least-32-chars

# -----------------------------------------------------------------------------
# Observability (deploy/docker-compose.observability.yml, T046)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=internalchat
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# -----------------------------------------------------------------------------
# Application policy knobs
# -----------------------------------------------------------------------------
# 12-month hard retention (FR-052..054). Expressed in days.
RETENTION_DAYS=365
# Membership authorization cache TTL. Principle VII caps this at 60s; research.md
# D6 chose 30s so SC-018's 5-minute revocation budget keeps its margin.
MEMBERSHIP_CACHE_TTL_SECONDS=30
# Attachment ceilings (FR-023).
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=524288000
# Explicit CORS allow-list. Wildcards are prohibited (Principle IV).
CORS_ALLOWED_ORIGINS=http://localhost:8080
