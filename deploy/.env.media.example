# ---------------------------------------------------------------------------
# Media host configuration (T185). Copy to .env.media and fill in.
#
# This file is an EXAMPLE and contains no secrets. deploy/.env.media is
# gitignored alongside deploy/.env.
# ---------------------------------------------------------------------------

# Shared with the application host's LiveKit__ApiKey / LiveKit__ApiSecret.
# The secret mints admission to any meeting (FR-041) and authenticates every
# webhook claim about who attended one (FR-051). Generate with:
#   openssl rand -base64 48
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me-with-a-48-byte-random-value

# The media host's public hostname, used for the TURN TLS certificate.
TURN_DOMAIN=media.internalchat.invalid

# Where LiveKit posts room lifecycle events. Must reach the application host's
# nginx, which forwards to /webhooks/livekit.
WEBHOOK_URL=https://internalchat.invalid/webhooks/livekit
