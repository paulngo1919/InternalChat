<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Constitution Principle I: Infrastructure implements Application's interfaces and is
    referenced by nobody except the composition roots (Api, Worker) for DI registration.
  -->
  <PropertyGroup>
    <!-- Suppress analyzer warnings on auto-generated EF Migrations -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InternalChat.Application\InternalChat.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Lib.Net.Http.WebPush" />
    <PackageReference Include="Minio" />
  </ItemGroup>

  <ItemGroup Label="Design-time only — EF Core migrations">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
